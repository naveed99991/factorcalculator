{
  "name": "factorcalculator",
  "version": "1.0.0",
  "private": true,
  "description": "Factor Calculator \u2014 find factors, prime factorization, GCF, LCM, and more",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "jest",
    "test:watch": "jest --watch",
    "validate:content": "node scripts/validate-content.js",
    "validate:structure": "node scripts/validate-structure.js",
    "deploy": "next build && wrangler pages deploy out --project-name=factorcalculator",
    "preview:cf": "next build && wrangler pages dev out"
  },
  "dependencies": {
    "@next/third-parties": "^16.3.3",
    "next": "16.3.3",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@babel/preset-env": "7.26.0",
    "@types/node": "22.10.0",
    "autoprefixer": "10.4.20",
    "babel-jest": "29.7.0",
    "eslint": "9.16.0",
    "eslint-config-next": "16.3.3",
    "jest": "29.7.0",
    "jest-environment-jsdom": "29.7.0",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.16",
    "wrangler": "^4.131.2"
  },
  "engines": {
    "node": ">=22"
  }
}